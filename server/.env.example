# ═══ إعدادات رفيق — انسخ هذا الملف إلى .env وعدّل القيم. لا تشارك ملف .env مع أحد ولا ترفعه إلى GitHub.

# ——— الخادم
HARITH_HOST=127.0.0.1          # 127.0.0.1 = من نفس الجوال فقط (الأكثر أمانًا). 0.0.0.0 = من الشبكة المحلية
HARITH_PORT=8787
HARITH_TIMEZONE=Asia/Riyadh
# HARITH_DATA_DIR=./data       # مكان قاعدة البيانات والملفات والنسخ الاحتياطية
# HARITH_ADMIN_PASSWORD=       # اختياري: ينشئ حساب admin تلقائيًا أول مرة (أو أنشئه من اللوحة)

# ——— الذكاء الاصطناعي (اختر مزوّدًا واحدًا على الأقل)
AI_PROVIDER=gemini             # gemini | openai | anthropic | openrouter | custom
AI_MODEL=                      # اتركه فارغًا للافتراضي (gemini-flash-latest)
AI_FALLBACK_PROVIDER=          # مزوّد احتياطي عند تعطل الأساسي (اختياري)
GEMINI_API_KEY=                # https://aistudio.google.com/apikey
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
CUSTOM_BASE_URL=               # أي خدمة متوافقة مع OpenAI (Groq, DeepSeek, Ollama محلي...) مثال: http://127.0.0.1:11434/v1
CUSTOM_API_KEY=

# ——— تيليجرام: أنشئ بوتًا من @BotFather والصق الرمز
TELEGRAM_BOT_TOKEN=

# ——— البحث في الإنترنت (اختياري؛ بدونهما يُستخدم بحث Google عبر Gemini)
TAVILY_API_KEY=
BRAVE_API_KEY=

# ——— البريد (للإرسال بعد موافقتك). لـ Gmail استخدم "كلمة مرور التطبيقات" وليس كلمة مرورك
SMTP_HOST=                     # smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ——— حدود الأمان
DAILY_COST_LIMIT_USD=2         # يتوقف المساعد عند تجاوز هذه التكلفة اليومية (قابل للتعديل من اللوحة)
TOOL_TIMEOUT_S=60
MAX_AGENT_STEPS=12
HISTORY_RETENTION_DAYS=90      # حذف المحادثات الأقدم تلقائيًا (0 = لا حذف)
BACKUP_KEEP=14                 # عدد النسخ الاحتياطية اليومية المحفوظة

# ——— توزيع رفيق على مستخدمين آخرين بلا إعداد (اختياري)
# مفتاح إدارة من openrouter.ai ← Settings ← Provisioning keys. يبقى هنا فقط ولا يصل لأي تطبيق.
OPENROUTER_PROVISIONING_KEY=
PROVISION_LIMIT_USD=5          # الحد الشهري لكل مستخدم بالدولار
PROVISION_LIMIT_RESET=monthly  # daily | weekly | monthly
PROVISION_MAX_DEVICES=200      # أقصى عدد مستخدمين
PROVISION_INVITE_CODE=         # اتركه فارغًا لتسجيل مفتوح، أو ضع رمزًا يوزَّع على من تريد فقط
PROVISION_MODEL=google/gemini-2.5-flash
